{
  "name": "RE AI Modeling",
  "image": "mcr.microsoft.com/devcontainers/base:2-noble",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "24"
    },
    "ghcr.io/devcontainers/features/java:1": {
      "version": "21"
    }
  },
  "postAttachCommand": "sleep 2 && code --command markdown.showPreview || true",
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md"
      ]
    },
    "vscode": {
      "settings": {
        "workbench.editorAssociations": {
          "**/README.md": "vscode.markdown.preview.editor"
        }
      },
      "extensions": [
        "GitHub.copilot",
        "GitHub.copilot-chat",
        "hediet.vscode-drawio",
        "jebbs.plantuml"
      ]
    }
  }
}
